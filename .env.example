# Copy this file to .env and fill in what you have.

# Optional: enables live fortune generation via Claude. Without this, the
# oracle uses a local offline generator instead (see server/fortune.js).
ANTHROPIC_API_KEY=

# Optional: enables a real, human-sounding voice via ElevenLabs. Without
# this, the oracle speaks with the browser's built-in Web Speech voice
# instead (see server/tts.js and public/js/speech.js).
ELEVENLABS_API_KEY=

# Optional: use a different ElevenLabs voice from your Voice Library.
# Defaults to "Lily", a warm, mature, British storyteller voice.
# ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku

# Optional: force a specific serial port for the Arduino instead of
# auto-detecting the first USB-serial device found.
# ARDUINO_PORT=/dev/tty.usbmodem14101

# Optional: change the port the server listens on (default 4173).
# PORT=4173
